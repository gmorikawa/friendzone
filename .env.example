# Optional host port published by Nginx. Defaults to 80 when unset or empty.
NGINX_PORT=5080

# Required public URL settings. Fill every value; there are no defaults.
# DOMAIN: hostname only. PORT: public numeric port. SCHEMA: http or https.
WEB_CLIENT_DOMAIN=app.friendzone.local
WEB_CLIENT_PORT=5080
WEB_CLIENT_SCHEMA=http

OFFICE_CLIENT_DOMAIN=office.friendzone.local
OFFICE_CLIENT_PORT=5080
OFFICE_CLIENT_SCHEMA=http

CORE_DOMAIN=api.friendzone.local
CORE_PORT=5080
CORE_SCHEMA=http

EMAIL_DOMAIN=email.friendzone.local
EMAIL_PORT=5080
EMAIL_SCHEMA=http
