map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $host $backend {
    default "";
    "${CORE_DOMAIN}" core:8080;
    "${WEB_CLIENT_DOMAIN}" web-client:5173;
    "${OFFICE_CLIENT_DOMAIN}" office-client:4200;
    "${EMAIL_DOMAIN}" email:8025;
}

# Browsers omit the default port when serializing an origin.
map "${WEB_CLIENT_SCHEMA}:${WEB_CLIENT_PORT}" $web_default_port_origin {
    default "";
    "http:80" $http_origin;
    "https:443" $http_origin;
}

map "${OFFICE_CLIENT_SCHEMA}:${OFFICE_CLIENT_PORT}" $office_default_port_origin {
    default "";
    "http:80" $http_origin;
    "https:443" $http_origin;
}

# Apply browser API access only to the two development frontends.
map $http_origin $frontend_origin {
    default "";
    "${WEB_CLIENT_SCHEMA}://${WEB_CLIENT_DOMAIN}:${WEB_CLIENT_PORT}" $http_origin;
    "${OFFICE_CLIENT_SCHEMA}://${OFFICE_CLIENT_DOMAIN}:${OFFICE_CLIENT_PORT}" $http_origin;
    "${WEB_CLIENT_SCHEMA}://${WEB_CLIENT_DOMAIN}" $web_default_port_origin;
    "${OFFICE_CLIENT_SCHEMA}://${OFFICE_CLIENT_DOMAIN}" $office_default_port_origin;
}

map $host $cors_origin {
    default "";
    "${CORE_DOMAIN}" $frontend_origin;
}

map $host $is_core {
    default 0;
    "${CORE_DOMAIN}" 1;
}

map $host $public_schema {
    default $scheme;
    "${WEB_CLIENT_DOMAIN}" "${WEB_CLIENT_SCHEMA}";
    "${OFFICE_CLIENT_DOMAIN}" "${OFFICE_CLIENT_SCHEMA}";
    "${CORE_DOMAIN}" "${CORE_SCHEMA}";
    "${EMAIL_DOMAIN}" "${EMAIL_SCHEMA}";
}

map $host $public_port {
    default $server_port;
    "${WEB_CLIENT_DOMAIN}" "${WEB_CLIENT_PORT}";
    "${OFFICE_CLIENT_DOMAIN}" "${OFFICE_CLIENT_PORT}";
    "${CORE_DOMAIN}" "${CORE_PORT}";
    "${EMAIL_DOMAIN}" "${EMAIL_PORT}";
}

map $cors_origin $cors_methods {
    default "";
    ~.+ "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS";
}

map $cors_origin $cors_headers {
    default "";
    ~.+ $http_access_control_request_headers;
}

map "$is_core:$request_method:$http_access_control_request_method" $api_preflight {
    default 0;
    ~^1:OPTIONS:.+ 1;
}

map "$api_preflight:$cors_origin" $reject_preflight {
    default 0;
    "1:" 1;
}

server {
    listen 80 default_server;
    server_name _;
    return 404;
}

server {
    listen 80;
    server_name ${CORE_DOMAIN} ${WEB_CLIENT_DOMAIN}
                ${OFFICE_CLIENT_DOMAIN} ${EMAIL_DOMAIN};

    resolver 127.0.0.11 valid=5s ipv6=off;

    location / {
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Allow-Methods $cors_methods always;
        add_header Access-Control-Allow-Headers $cors_headers always;
        add_header Vary Origin always;

        if ($reject_preflight) {
            return 403;
        }
        if ($api_preflight) {
            return 204;
        }

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $public_schema;
        proxy_set_header X-Forwarded-Port $public_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_buffering off;
    }
}
